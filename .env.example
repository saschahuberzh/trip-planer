# Public, browser-side configuration only (V1 has no server secrets).
# Copy to .env.local for local overrides; set the same names in Vercel → Settings → Environment Variables.
# All are optional; the defaults need no API key.

# MapLibre style URL for map tiles (default: OpenFreeMap "liberty", no key).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Photon place search endpoint (default: the public komoot instance).
# NEXT_PUBLIC_PHOTON_URL=https://photon.komoot.io/api/
